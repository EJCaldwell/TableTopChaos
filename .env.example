# ---------------------------------------------------------------------------
# D&D Campaign Manager — frontend environment template.
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Project Settings → API). Vite only exposes variables prefixed with `VITE_`
# to client code, so everything here is PUBLIC by design:
#   - The anon/publishable key is safe to ship to browsers; Row-Level Security
#     (RLS) — not key secrecy — is what protects the data.
#   - NEVER put the Supabase service-role key or any Stripe secret key in this
#     file. Those live only in Edge Function secrets, never in the client.
# ---------------------------------------------------------------------------

# Base URL of your Supabase project, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Publishable / anon key (Project Settings → API → Project API keys → anon public)
VITE_SUPABASE_ANON_KEY=
