# ---------------------------------------------------------------------------
# Phase 6.2 migration credentials — copy to railway/.env.migrate and fill in.
#
# These belong to the SOURCE project (hosted Supabase, `fnykpoattheldxtkrozd`),
# not to the self-hosted stack. They exist only for the one-off data move.
#
# Distinct from railway/.env.stack in both direction and lifetime:
#   .env.stack   — secrets the NEW stack runs on, long-lived.
#   .env.migrate — read access to the OLD project, delete after cutover.
#
# Already gitignored. Nothing in here should ever be echoed to a terminal, put
# in a command line (it lands in shell history), or pasted into a chat — source
# the file instead: `set -a; . railway/.env.migrate; set +a`.
# ---------------------------------------------------------------------------

# Dashboard → Project Settings → Database → Connection string → URI.
# Use the DIRECT connection (port 5432), not the pooler: pg_dump needs session
# state that a transaction pooler does not provide.
# Format: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SOURCE_DB_URL=

# Dashboard → Project Settings → API → Project API keys → `service_role`.
# Needed to read the `media` bucket, which is private: its objects are reachable
# only by a key that bypasses RLS, or by a signed URL.
#
# THIS KEY BYPASSES ROW-LEVEL SECURITY ENTIRELY. It is the one credential in
# this project that ignores all 100 policies. Rotate it after the cutover if it
# has been on a machine you do not fully control.
SOURCE_SERVICE_ROLE_KEY=

# Project ref of the source project. Used to build the storage API base URL.
SOURCE_PROJECT_REF=fnykpoattheldxtkrozd
