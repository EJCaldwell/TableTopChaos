# ---------------------------------------------------------------------------
# Backend stack secrets. Copy to railway/.env.stack for local runs, and set the
# same values as Railway SHARED variables so all services read one source.
#
# THESE ARE SERVER SECRETS — unlike the frontend .env, nothing here is public.
# Ensure railway/.env.stack is gitignored before filling it in.
#
# Generate the first three together (they are cryptographically linked — the two
# keys are JWTs signed with JWT_SECRET):
#   node railway/scripts/gen-keys.mjs
# ---------------------------------------------------------------------------

# Shared signing secret. GoTrue signs with it; PostgREST/Storage/Realtime verify
# with it. Rotating this invalidates both keys AND every live user session.
JWT_SECRET=

# HS256 JWTs derived from JWT_SECRET. Do not invent these by hand.
ANON_KEY=
SERVICE_ROLE_KEY=

# Postgres superuser password.
POSTGRES_PASSWORD=

# Realtime requires these at exactly these lengths or it refuses to boot:
#   openssl rand -hex 8      → 16 chars
REALTIME_ENC_KEY=
#   openssl rand -hex 32     → 64 chars
REALTIME_SECRET_KEY_BASE=

# --- URLs -----------------------------------------------------------------
# SITE_URL   = where the FRONTEND runs (email links redirect here).
# PUBLIC_URL = the public GATEWAY origin (what VITE_SUPABASE_URL points at).
# Locally these differ (5173 vs 8000); in production both are your real domains.
#
# Optional: set GATEWAY_PORT (and match it in the two URLs below) if another
# local project already binds 8000.
SITE_URL=http://localhost:5173
PUBLIC_URL=http://localhost:8000

# Local QA convenience: auto-confirm signups so test users can be created freely.
# MUST be false in production — otherwise anyone can register as any address.
MAILER_AUTOCONFIRM=true

# --- Stripe ---------------------------------------------------------------
# Use TEST keys locally. STRIPE_WEBHOOK_SIGNING_SECRET is environment-specific: the
# secret from your live endpoint will NOT verify against `stripe listen`, and a
# new Railway domain means registering a new endpoint and a new secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_SEMIANNUAL=
STRIPE_PRICE_ANNUAL=
TRIAL_PERIOD_DAYS=30
