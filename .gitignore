# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local environment — NEVER commit real keys. Only .env.example is tracked.
.env
.env.local
.env.*.local

# Self-hosted (Railway) backend stack secrets. Unlike the frontend .env these are
# real server secrets: JWT_SECRET, service-role key, Postgres password.
# Only railway/.env.stack.example is tracked.
railway/.env.stack
railway/.env.stack.*
!railway/.env.stack.example

# Supabase local stack & secrets
supabase/.branches/
supabase/.temp/
.supabase/

# Editor / OS
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/

# Build caches (regenerate locally; committing them just causes noisy diffs)
*.tsbuildinfo

# Python virtualenv (used for local QA tooling — exiftool/Pillow, etc.)
.venv/
