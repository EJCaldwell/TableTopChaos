# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Local environment — NEVER commit real keys. Only .env.example is tracked.
.env
.env.local
.env.*.local

# Self-hosted (Railway) backend stack secrets. Unlike the frontend .env these are
# real server secrets: JWT_SECRET, service-role key, Postgres password.
# Only railway/.env.stack.example is tracked.
railway/.env.stack
railway/.env.stack.*
!railway/.env.stack.example

# Phase 6.2 one-off migration credentials: the SOURCE (hosted) project's database
# password and service-role key. Delete this file once the cutover is done.
railway/.env.migrate
railway/.env.migrate.*
!railway/.env.migrate.example

# Phase 6.2 working directory: dumps of live data and downloaded media.
railway/migrate-out/

# Supabase local stack & secrets
supabase/.branches/
supabase/.temp/
.supabase/

# Editor / OS
.DS_Store
*.log
.vscode/*
!.vscode/extensions.json
.idea/

# Build caches (regenerate locally; committing them just causes noisy diffs)
*.tsbuildinfo

# Test output (Phase 8.1). `npm run coverage` writes an HTML report here —
# ~3.4 MB across ~100 generated files, regenerated on every run, and a source of
# enormous meaningless diffs if tracked. The numbers that matter are recorded in
# QA/8.1_tests/automated-coverage.md instead.
coverage/
# Vitest's on-disk cache, if the default location is ever used.
.vitest/

# Python virtualenv (used for local QA tooling — exiftool/Pillow, etc.)
.venv/
