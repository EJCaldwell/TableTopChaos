{
  "name": "tabletopchaos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TableTopChaos — a glorified notepad for tabletop RPG campaigns (React + TypeScript + Supabase).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "qa:checks": "tsc -p tsconfig.qa.json && tsx QA/tools/layout-checks.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
